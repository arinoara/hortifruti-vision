# Copie este arquivo para .env e preencha sua chave do OpenRouter
# (https://openrouter.ai/keys)
OPENROUTER_API_KEY=coloque_sua_chave_aqui

# Modelo multimodal (precisa aceitar imagem). Lista: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Índice da webcam (0 = padrão do sistema)
CAMERA_INDICE=0

# Abaixo desta confiança o agente pergunta ao operador
CONFIANCA_MINIMA=0.7
MAX_PASSOS_REACT=8
